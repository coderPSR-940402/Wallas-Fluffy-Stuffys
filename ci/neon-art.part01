import math, random
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont, ImageFilter, ImageChops

SIZE=512; CENTER=SIZE//2; font_path='/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf'; random.seed(19)
PINK=(255,28,182); PURPLE=(120,42,255); CYAN=(58,232,255); WHITE=(251,249,255); MAGENTA=(255,79,221); INK=(30,8,47)

def text_symbol(text,img,size=220,offset=(0,0)):
    d=ImageDraw.Draw(img); font=ImageFont.truetype(font_path,size); bbox=d.textbbox((0,0),text,font=font); w,h=bbox[2]-bbox[0],bbox[3]-bbox[1]; x=(SIZE-w)//2+offset[0]; y=(SIZE-h)//2-bbox[1]+offset[1]; d.text((x,y), text, fill=255, font=font)

def icon_mask(symbol):
