    elif symbol=='download': rr((205,90,307,285),40); d.polygon([(145,240),(367,240),(256,392)],fill=255); rr((125,394,387,438),22)
    elif symbol in ('browser','browser_o','firefox'): d.ellipse((104,104,408,408),outline=255,width=68); d.ellipse((212,212,300,300),fill=255); d.rectangle((290,152,360,228),fill=255) if symbol=='browser_o' else None
    if symbol=='firefox': d.pieslice((88,88,424,424),start=235,end=55,fill=255); d.ellipse((184,184,328,328),fill=0)
    elif symbol=='play': d.rounded_rectangle((125,150,390,360),radius=70,outline=255,width=56); d.polygon([(224,204),(330,256),(224,308)],fill=255)
    elif symbol=='flower':
        for angle in range(0,360,72): rad=math.radians(angle); x=CENTER+math.cos(rad)*92; y=CENTER+math.sin(rad)*92; d.ellipse((x-68,y-68,x+68,y+68),fill=255)
        d.ellipse((206,206,306,306),fill=0); d.ellipse((226,226,286,286),fill=255)
    elif symbol=='network':
        pts=[(256,115),(150,218),(362,218),(128,365),(256,365),(384,365)]
        for a,b in [(0,1),(0,2),(1,3),(1,4),(2,4),(2,5)]: d.line((pts[a],pts[b]),fill=255,width=34)
        for p in pts: d.ellipse((p[0]-40,p[1]-40,p[0]+40,p[1]+40),fill=255)
    elif symbol=='canva_c': d.arc((120,120,392,392),start=40,end=320,fill=255,width=84)
    elif symbol=='sliders':
        for y,x in [(176,170),(256,320),(336,220)]: d.line((122,y,390,y),fill=255,width=40); d.ellipse((x-40,y-40,x+40,y+40),fill=255)
    elif symbol=='package_box': d.polygon([(256,106),(382,180),(256,252),(130,180)],fill=255); d.polygon([(130,180),(256,252),(256,382),(130,308)],fill=255); d.polygon([(382,180),(256,252),(256,382),(382,308)],fill=255)
    elif symbol=='rocket': d.polygon([(256,96),(340,220),(300,364),(212,364),(172,220)],fill=255); d.rectangle((228,320,284,430),fill=255); d.ellipse((232,180,280,228),fill=0); d.ellipse((240,188,272,220),fill=255)
    elif symbol in ('kwgt','kustom_k'): text_symbol('K',img,size=250)
    elif symbol=='atom':
        for rot in [0,60,120]: temp=Image.new('L',(SIZE,SIZE),0); td=ImageDraw.Draw(temp); td.ellipse((146,204,366,308),outline=255,width=22); temp=temp.rotate(rot,resample=Image.Resampling.BICUBIC,center=(CENTER,CENTER)); img=ImageChops.lighter(img,temp)
        ImageDraw.Draw(img).ellipse((229,229,283,283),fill=255)
    elif symbol=='ai_loop': d.arc((122,122,390,390),start=30,end=330,fill=255,width=42); d.line((158,366,356,144),fill=255,width=66); d.line((192,144,356,144),fill=255,width=56)
    elif symbol=='perplexity':
        for ang in [0,45,90,135]: temp=Image.new('L',(SIZE,SIZE),0); td=ImageDraw.Draw(temp); td.rounded_rectangle((232,106,280,406),radius=24,fill=255); td.rounded_rectangle((106,232,406,280),radius=24,fill=255); temp=temp.rotate(ang,resample=Image.Resampling.BICUBIC,center=(CENTER,CENTER)); img=ImageChops.lighter(img,temp)
    elif symbol=='music': d.ellipse((282,274,388,380),fill=255); d.rectangle((255,145,285,330),fill=255); d.polygon([(285,145),(365,170),(365,214),(285,194)],fill=255)
    elif symbol=='doc': rr((155,110,355,402),36); d.polygon([(286,110),(355,180),(355,110)],fill=0); [d.line((205,y,318 if y<332 else 292,y),fill=0,width=18) for y in [232,282,332]]
    elif symbol=='note': rr((142,122,372,392),48); [d.line((190,y,320 if y<330 else 286,y),fill=0,width=20) for y in [218,274,330]]
